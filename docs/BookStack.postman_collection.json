        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract tokens from response and set as collection variable",
                  "const jsonData = pm.response.json();",
                  "",
                  "// Extract the access_token from the response",
                  "const accessToken = jsonData.access_token;",
                  "const refreshToken = jsonData.refresh_token;",
                  "",
                  "// Set the access_token and refresh_token as a collection variable",
                  "if (accessToken) {",
                  "    pm.collectionVariables.set(\"BookStackToken\", accessToken);",
                  "}",
                  "if (refreshToken){",
                  "    pm.collectionVariables.set(\"BookStackRefreshToken\", refreshToken);",
                  "}",
                  "",
                  "// Test to verify the token was successfully extracted and set",
                  "pm.test(\"Access token was successfully extracted and stored\", function() {",
                  "    pm.expect(accessToken).to.be.a('string');",
                  "    pm.expect(accessToken).to.not.be.empty;",
                  "    ",
                  "    const storedToken = pm.collectionVariables.get(\"BookStackToken\");",
                  "    pm.expect(storedToken).to.eql(accessToken);",
                  "});",
                  "",
                  "// Test to verify the refresh_token was successfully extracted and set",
                  "pm.test(\"Refres token was successfully extracted and stored\", function() {",
                  "    pm.expect(refreshToken).to.be.a('string');",
                  "    pm.expect(refreshToken).to.not.be.empty;",
                  "    ",
                  "    const storedToken = pm.collectionVariables.get(\"BookStackRefreshToken\");",
                  "    pm.expect(storedToken).to.eql(refreshToken);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"johndoe@mail.com\",\r\n    \"password\": \"passPrueba123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BookStackBaseURL}}/auth/login",
              "host": [
                "{{BookStackBaseURL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
